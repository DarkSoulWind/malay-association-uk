---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Malay Community Activities"
  description="Explore MAUK activities, from Hari Raya gatherings and makan events to youth support, welfare visits and cultural learning."
  image="/assets/community-event.jpg"
>
  <section class="page-hero">
    <p class="eyebrow">Activities</p>
    <h1>Culture, food and care in motion.</h1>
    <p>
      Some activities are loud and full of food. Others are quiet visits, calls
      and support behind the scenes. Together they keep Malay community life moving.
    </p>
  </section>

  <section class="page-section">
    <div class="activities-showcase">
      <article class="activity-tile">
        <span>01</span>
        <h3>Warisan Learning</h3>
        <p>Language, values, history, cuisine and traditions shared through sessions families can join together.</p>
      </article>
      <article class="activity-tile">
        <span>02</span>
        <h3>Raya & Community Days</h3>
        <p>Hari Raya, Eid, Merdeka moments, picnics and potlucks that keep generations connected.</p>
      </article>
      <article class="activity-tile">
        <span>03</span>
        <h3>Makan & Cuisine</h3>
        <p>Community meals, bazaars and food-led gatherings where hospitality begins with flavour.</p>
      </article>
      <article class="activity-tile">
        <span>04</span>
        <h3>Youth & Skills</h3>
        <p>Study sessions, skills workshops and career talks for younger community members.</p>
      </article>
      <article class="activity-tile">
        <span>05</span>
        <h3>Warga Emas Visits</h3>
        <p>Ramadan gifts, check-ins and practical care for elderly members of the community.</p>
      </article>
      <article class="activity-tile">
        <span>06</span>
        <h3>Hard Times & Loss</h3>
        <p>Community notices, prayers, temporary support and signposting when families need help.</p>
      </article>
    </div>
  </section>

  <section class="activities-involvement" aria-labelledby="activity-vision-title">
    <div class="activities-involvement-copy">
      <p class="eyebrow">Get Involved</p>
      <h2 id="activity-vision-title">Bring a skill, a space, a dish or a pair of hands.</h2>
      <p>
        MAUK runs on volunteers, venue leads, food contributors, organisers,
        donors and people who know how to bring others into the room.
      </p>
      <a class="text-link" href="/contact">Contact MAUK</a>
    </div>
    <figure class="activities-involvement-image">
      <img src="/assets/study-session.jpg" alt="A community study session with children and volunteers seated at tables" />
    </figure>
  </section>
</BaseLayout>
