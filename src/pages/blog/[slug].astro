---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import InstagramEmbed from "@components/InstagramEmbed.astro";
import PostCard from "@components/PostCard.astro";
import { breadcrumbJsonLd, organizationJsonLd } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((entry) => entry.data.contentType !== "event");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = await getCollection("posts");
const relatedPosts = allPosts
  .filter((entry) => entry.slug !== post.slug && entry.data.contentType !== "event" && entry.data.category === post.data.category)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric"
});

const displayDate = post.data.eventDate ?? post.data.publishedDate;
const dateLabel = dateFormatter.format(displayDate);
const hasEventDetails = post.data.eventDate || post.data.venue || post.data.eventStartTime || post.data.entryFee;
const instagramUrls = post.data.instagramUrls.length > 0
  ? post.data.instagramUrls
  : post.data.instagramUrl
    ? [post.data.instagramUrl]
    : [];
const siteUrl = (Astro.site ?? new URL("https://malayassociation.co.uk")).toString().replace(/\/$/, "");
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const organization = organizationJsonLd(siteUrl);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  headline: post.data.title,
  description: post.data.excerpt,
  image: [new URL(post.data.featuredImage, `${siteUrl}/`).toString()],
  datePublished: post.data.publishedDate.toISOString(),
  dateModified: post.data.publishedDate.toISOString(),
  mainEntityOfPage: pageUrl,
  author: organization,
  publisher: organization
};
const breadcrumbJsonLdItem = breadcrumbJsonLd([
  { name: "Home", url: `${siteUrl}/` },
  { name: "Blog", url: `${siteUrl}/blog/` },
  { name: post.data.title, url: pageUrl }
]);
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.featuredImage}
  imageAlt={post.data.imageAlt}
  structuredData={[articleJsonLd, breadcrumbJsonLdItem]}
  type="article"
  publishedTime={post.data.publishedDate.toISOString()}
  modifiedTime={post.data.publishedDate.toISOString()}
>
  <article class="article-shell">
    <header class="article-header">
      <div class="meta-row">
        <span>{post.data.category}</span>
        <time datetime={displayDate.toISOString()}>{dateLabel}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.excerpt}</p>
    </header>

    {instagramUrls.length > 0 ? (
      <div class="instagram-embed-list">
        {instagramUrls.map((url) => <InstagramEmbed url={url} />)}
      </div>
    ) : (
      <div class="article-image">
        <img src={post.data.featuredImage} alt={post.data.imageAlt} />
      </div>
    )}
    {instagramUrls.length > 0 && <script is:inline async src="https://www.instagram.com/embed.js"></script>}

    <div class="article-grid">
      <div class="prose">
        {post.data.sensitivity === "remembrance" && (
          <p class="sensitivity-note">
            This is a remembrance notice. Names, dates and funeral details should
            be confirmed with the family or MAUK before republication.
          </p>
        )}
        <Content />
      </div>

      <aside class="article-sidebar" aria-label="Post details">
        {hasEventDetails && (
          <section class="event-detail-box">
            <h2>Event Details</h2>
            <dl>
              {post.data.eventDate && (
                <div>
                  <dt>Date</dt>
                  <dd>{dateFormatter.format(post.data.eventDate)}</dd>
                </div>
              )}
              {(post.data.eventStartTime || post.data.eventEndTime) && (
                <div>
                  <dt>Time</dt>
                  <dd>{post.data.eventStartTime}{post.data.eventEndTime ? ` - ${post.data.eventEndTime}` : ""}</dd>
                </div>
              )}
              {post.data.venue && (
                <div>
                  <dt>Venue</dt>
                  <dd>{post.data.venue}</dd>
                </div>
              )}
              {post.data.entryFee && (
                <div>
                  <dt>Entry</dt>
                  <dd>{post.data.entryFee}</dd>
                </div>
              )}
              <div>
                <dt>Status</dt>
                <dd>{post.data.isPastEvent ? "Past event" : "Upcoming"}</dd>
              </div>
            </dl>
          </section>
        )}

        <section class="event-detail-box">
          <h2>Archive Metadata</h2>
          <dl>
            <div>
              <dt>Published</dt>
              <dd>{dateFormatter.format(post.data.publishedDate)}</dd>
            </div>
            <div>
              <dt>Category</dt>
              <dd>{post.data.category}</dd>
            </div>
            <div>
              <dt>Sensitivity</dt>
              <dd>{post.data.sensitivity}</dd>
            </div>
          </dl>
        </section>
      </aside>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="section-heading">
        <p class="eyebrow">Related</p>
        <h2 id="related-title">More {post.data.category.toLowerCase()}</h2>
      </div>
      <div class="post-grid">
        {relatedPosts.map((entry) => <PostCard post={entry} compact />)}
      </div>
    </section>
  )}
</BaseLayout>
