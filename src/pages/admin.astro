<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>MAUK Content Admin</title>
  </head>
  <body>
    <script is:inline>
      if (window.location.pathname === "/admin") {
        window.location.replace(`/admin/${window.location.search}${window.location.hash}`);
      } else {
        const decap = document.createElement("script");
        decap.src = "https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js";
        document.body.appendChild(decap);
      }
    </script>
  </body>
</html>
