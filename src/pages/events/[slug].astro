---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((entry) => entry.data.contentType === "event");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = await getCollection("posts");
const relatedPosts = allPosts
  .filter((entry) => entry.slug !== post.slug && entry.data.contentType === "event")
  .sort((a, b) => (b.data.eventDate?.valueOf() ?? 0) - (a.data.eventDate?.valueOf() ?? 0))
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric"
});

const displayDate = post.data.eventDate ?? post.data.publishedDate;
const dateLabel = dateFormatter.format(displayDate);
const siteUrl = (Astro.site ?? new URL("https://malayassociation.co.uk")).toString().replace(/\/$/, "");
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const confirmedText = (value?: string) => Boolean(value && !/to be verified/i.test(value));
const schemaDate = (date: Date, time?: string) => {
  const datePart = date.toISOString().slice(0, 10);

  if (time && /^\d{1,2}:\d{2}$/.test(time)) {
    return `${datePart}T${time.padStart(5, "0")}:00+00:00`;
  }

  return datePart;
};
const confirmedVenue = confirmedText(post.data.venue) ? post.data.venue : undefined;
const eventJsonLd = post.data.eventDate && confirmedVenue
  ? {
      "@context": "https://schema.org",
      "@type": "Event",
      "@id": `${pageUrl}#event`,
      name: post.data.title,
      description: post.data.excerpt,
      url: pageUrl,
      image: [new URL(post.data.featuredImage, `${siteUrl}/`).toString()],
      startDate: schemaDate(post.data.eventDate, post.data.eventStartTime),
      ...(post.data.eventEndTime && /^\d{1,2}:\d{2}$/.test(post.data.eventEndTime)
        ? { endDate: schemaDate(post.data.eventDate, post.data.eventEndTime) }
        : {}),
      eventStatus: post.data.isPastEvent
        ? "https://schema.org/EventCompleted"
        : "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: confirmedVenue,
        address: {
          "@type": "PostalAddress",
          addressCountry: "GB"
        }
      },
      organizer: {
        "@type": "Organization",
        name: "Malay Association UK",
        url: `${siteUrl}/`
      }
    }
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.featuredImage}
  structuredData={eventJsonLd}
  type="article"
>
  <article class="article-shell">
    <header class="article-header">
      <div class="meta-row">
        <span>Event listing</span>
        <span>{post.data.category}</span>
        <time datetime={displayDate.toISOString()}>{dateLabel}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.excerpt}</p>
    </header>

    <div class="article-image">
      <img src={post.data.featuredImage} alt={post.data.imageAlt} />
    </div>

    <div class="article-grid">
      <div class="prose">
        <Content />
      </div>

      <aside class="article-sidebar" aria-label="Event details">
        <section class="event-detail-box">
          <h2>Event Details</h2>
          <dl>
            {post.data.eventDate && (
              <div>
                <dt>Date</dt>
                <dd>{dateFormatter.format(post.data.eventDate)}</dd>
              </div>
            )}
            {(post.data.eventStartTime || post.data.eventEndTime) && (
              <div>
                <dt>Time</dt>
                <dd>{post.data.eventStartTime}{post.data.eventEndTime ? ` - ${post.data.eventEndTime}` : ""}</dd>
              </div>
            )}
            {post.data.venue && (
              <div>
                <dt>Venue</dt>
                <dd>{post.data.venue}</dd>
              </div>
            )}
            {post.data.entryFee && (
              <div>
                <dt>Entry</dt>
                <dd>{post.data.entryFee}</dd>
              </div>
            )}
            <div>
              <dt>Status</dt>
              <dd>{post.data.isPastEvent ? "Past event" : "Upcoming"}</dd>
            </div>
          </dl>
        </section>

        <section class="event-detail-box">
          <h2>Content Type</h2>
          <p>
            This is an event listing. Post-event stories, thank-you notes and
            community updates are kept in the blog archive.
          </p>
        </section>
      </aside>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="section-heading">
        <p class="eyebrow">More Events</p>
        <h2 id="related-title">Other event listings</h2>
      </div>
      <div class="post-grid">
        {relatedPosts.map((entry) => <PostCard post={entry} compact />)}
      </div>
    </section>
  )}
</BaseLayout>
