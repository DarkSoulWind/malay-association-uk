---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.contentType !== "event")
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const latestPosts = posts.slice(0, 3);
const siteUrl = (Astro.site ?? new URL("https://malayassociation.co.uk")).toString().replace(/\/$/, "");
const organizationId = `${siteUrl}/#organization`;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "Malay Association UK",
  alternateName: "Malay Association United Kingdom",
  url: `${siteUrl}/`,
  image: `${siteUrl}/assets/hero-community.jpg`,
  description:
    "Malay Association UK is a registered charity supporting Malay culture, language, education, welfare and community life in the UK.",
  email: "ukmalayclub@hotmail.com",
  identifier: [
    {
      "@type": "PropertyValue",
      propertyID: "Charity Commission for England and Wales",
      value: "1186880"
    },
    {
      "@type": "PropertyValue",
      propertyID: "Charitable Incorporated Organisation",
      value: "CE019955"
    }
  ],
  areaServed: {
    "@type": "Country",
    name: "United Kingdom"
  },
  sameAs: [
    "https://www.instagram.com/malayassociation_uk/",
    "https://www.facebook.com/MalayClub-Uk-563146760820930/"
  ]
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: "Malay Association UK",
  url: `${siteUrl}/`,
  publisher: {
    "@id": organizationId
  }
};
---

<BaseLayout
  title="Malay Association UK | Malay Culture, Events & Community in the UK"
  description="Malay Association UK is a registered charity supporting Malay culture, language, events, education, welfare and community life across the UK."
  structuredData={[organizationJsonLd, websiteJsonLd]}
>
  <section class="heritage-hero" aria-labelledby="heritage-hero-title">
    <div class="heritage-hero-copy">
      <p class="eyebrow">Malay Association United Kingdom</p>
      <h1 id="heritage-hero-title">Preserving Malay heritage. Serving families across Britain.</h1>
      <p>
        MAUK is a registered charity supporting Malay culture, language,
        education, welfare and community life in the UK.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/about">Our Story</a>
        <a class="button secondary" href="/activities">Our Work</a>
      </div>
    </div>

    <aside class="heritage-portrait" aria-label="Malay Association UK community photograph">
      <img src="/assets/community-members.jpg" alt="MAUK members standing together in traditional Malay clothing" />
      <div>
        <strong>Established community roots</strong>
        <span>From Kelab Melayu history to a registered UK charity.</span>
      </div>
    </aside>
  </section>

  <section class="heritage-facts" aria-label="Organisation details">
    <div>
      <span>Registered charity</span>
      <strong>1186880</strong>
    </div>
    <div>
      <span>CIO number</span>
      <strong>CE019955</strong>
    </div>
    <div>
      <span>Purpose</span>
      <strong>Culture, education and welfare</strong>
    </div>
  </section>

  <section class="heritage-section heritage-purpose" aria-labelledby="heritage-purpose-title">
    <div class="heritage-heading" data-reveal="bubble">
      <p class="eyebrow">Purpose</p>
      <h2 id="heritage-purpose-title">A trusted cultural association preserving Malay identity in Britain.</h2>
    </div>
    <div class="heritage-purpose-grid" data-reveal="bubble">
      <article class="heritage-panel">
        <h3>Heritage</h3>
        <p>Malay language, values, foodways, stories and traditions passed between generations.</p>
      </article>
      <article class="heritage-panel">
        <h3>Education</h3>
        <p>Youth support, workshops, cultural learning and practical guidance for families.</p>
      </article>
      <article class="heritage-panel">
        <h3>Welfare</h3>
        <p>Elder visits, Ramadan support, bereavement notices and care for members facing hardship.</p>
      </article>
    </div>
  </section>

  <section class="heritage-band" aria-labelledby="heritage-history-title">
    <div class="heritage-band-copy" data-reveal="bubble">
      <p class="eyebrow">Community History</p>
      <h2 id="heritage-history-title">Little by little, the hill is formed.</h2>
      <p>
        <em>Sikit-Sikit, Lama-Lama Jadi Bukit</em> describes MAUK's growth: a
        network of families, elders, volunteers and friends becoming an organised
        charity with a wider duty of care.
      </p>
      <a class="text-link" href="/about">Read the history</a>
    </div>
    <figure class="heritage-archive-card" data-reveal="bubble">
      <img src="/assets/family-gathering.jpg" alt="MAUK community members gathered for an outdoor family event" />
      <figcaption>Community photographs should feel like archive material, not decoration.</figcaption>
    </figure>
  </section>

  <section class="heritage-section" aria-labelledby="heritage-work-title">
    <div class="heritage-heading" data-reveal="bubble">
      <p class="eyebrow">What MAUK Does</p>
      <h2 id="heritage-work-title">Cultural preservation with practical community service.</h2>
    </div>
    <div class="heritage-work-grid">
      <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 0ms">
        <span>01</span>
        <h3>Cultural gatherings</h3>
        <p>Hari Raya, food traditions, community meals and occasions that keep Malay identity visible.</p>
      </article>
      <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 70ms">
        <span>02</span>
        <h3>Family education</h3>
        <p>Learning, mentoring and workshops that support young people and parents.</p>
      </article>
      <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 140ms">
        <span>03</span>
        <h3>Care for elders</h3>
        <p>Warga Emas visits, Ramadan gifts and a more attentive welfare network.</p>
      </article>
      <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 210ms">
        <span>04</span>
        <h3>Community support</h3>
        <p>Bereavement support, hardship signposting and fundraising when families need help.</p>
      </article>
    </div>
  </section>

  <section class="heritage-section" aria-labelledby="heritage-latest-title">
    <div class="heritage-heading compact" data-reveal="bubble">
      <p class="eyebrow">Archive</p>
      <h2 id="heritage-latest-title">Recent records from the community.</h2>
    </div>
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
    <div class="button-row">
      <a class="button ghost" href="/blog">View blog archive</a>
      <a class="button ghost" href="/events">View event listings</a>
    </div>
  </section>
</BaseLayout>
