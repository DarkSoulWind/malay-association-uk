---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/PostCard.astro";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.contentType !== "event")
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="Malay Association UK"
  description="Malay Association UK brings Malay culture, food, language, events and community care to life across the UK."
>
  <div class="design-view design-current">
    <section class="hero" aria-labelledby="hero-title">
      <img src="/assets/hero-community.jpg" alt="MAUK community members gathered outdoors for a group photo" />
      <div class="hero-content">
        <p class="eyebrow">Malay culture in the UK</p>
        <h1 id="hero-title">Malay Association UK</h1>
        <p class="hero-copy">
          Food on the table, family in the room, culture in every detail. MAUK brings
          people together through Malay heritage, community events and gotong-royong
          care across the UK.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href="/events">See Events</a>
          <a class="button secondary" href="/contact">Get Involved</a>
        </div>
        <dl class="trust-strip" aria-label="Organisation facts">
          <div>
            <dt>Charity Number</dt>
            <dd>1186880</dd>
          </div>
          <div>
            <dt>Company Number</dt>
            <dd>CE019955</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="about-title">
      <div class="section-heading wide" data-reveal="bubble">
        <div>
          <p class="eyebrow">Who We Are</p>
          <h2 id="about-title">A Malay home away from home.</h2>
        </div>
        <p>
          MAUK started with friends and families making space for one another. Today
          it welcomes anyone who wants to celebrate Malay culture, learn the language,
          share food and look after the community.
        </p>
      </div>

      <div class="about-grid" data-reveal="bubble">
        <article class="story-panel">
          <p>
            The spirit of <em>Sikit-Sikit, Lama-Lama Jadi Bukit</em> still guides us:
            little by little, a gathering can become a community.
          </p>
          <p>
            You will find us around food tables, family days, youth sessions, Ramadan
            visits, cultural celebrations and the quiet work of checking in on people.
          </p>
          <div class="button-row">
            <a class="button ghost" href="/about">Read Our Story</a>
            <a class="button ghost" href="/activities">Explore Activities</a>
          </div>
        </article>
        <div class="image-card">
          <img src="/assets/community-members.jpg" alt="MAUK members standing together in traditional Malay clothing" />
        </div>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="vision-title">
      <div class="feature-copy" data-reveal="bubble">
        <p class="eyebrow">Our Next Chapter</p>
        <h2 id="vision-title">More tables, more volunteers, more places to gather.</h2>
        <p>
          We are building a stronger volunteer network, regular community spaces,
          youth involvement and steady support for the welfare work happening behind
          the scenes.
        </p>
        <a class="text-link" href="/contact">Offer a venue lead, skill or helping hand</a>
      </div>
      <div class="feature-image" data-reveal="bubble">
        <img src="/assets/potluck-hall.jpg" alt="A community hall arranged with food tables for a MAUK gathering" />
      </div>
    </section>

    <section class="section" aria-labelledby="activity-title">
      <div class="section-heading wide" data-reveal="bubble">
        <div>
          <p class="eyebrow">What We Do</p>
          <h2 id="activity-title">Culture you can taste, hear and take part in.</h2>
        </div>
        <p>
          Some days it is Hari Raya clothes and kuih. Some days it is homework help,
          welfare visits or a bazaar fundraiser. The point is the same: keep people
          connected and proud of where they come from.
        </p>
      </div>

      <div class="activity-grid">
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 0ms">
          <span class="activity-index">01</span>
          <h3>Raya & Cultural Days</h3>
          <p>Hari Raya, Merdeka moments and family gatherings that keep traditions alive.</p>
        </article>
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 70ms">
          <span class="activity-index">02</span>
          <h3>Youth & Skills</h3>
          <p>Study support, career talks and workshops that help young people feel ready.</p>
        </article>
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 140ms">
          <span class="activity-index">03</span>
          <h3>Makan Together</h3>
          <p>Potlucks, open picnics and food bazaars where culture starts with a plate.</p>
        </article>
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 0ms">
          <span class="activity-index">04</span>
          <h3>Warga Emas Care</h3>
          <p>Ramadan gifts, check-ins and practical support for elderly community members.</p>
        </article>
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 70ms">
          <span class="activity-index">05</span>
          <h3>Hardship Help</h3>
          <p>Small acts of support, signposting and fundraising when people need backup.</p>
        </article>
        <article class="activity-card" data-reveal="bubble" style="--reveal-delay: 140ms">
          <span class="activity-index">06</span>
          <h3>Family Support</h3>
          <p>Community notices, prayers and practical care when families go through loss.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-title">
      <div class="section-heading wide" data-reveal="bubble">
        <div>
          <p class="eyebrow">Latest</p>
          <h2 id="latest-title">Stories from the MAUK community.</h2>
        </div>
        <p>
          Recaps, thank-you notes, welfare updates and community notices now live in
          one place, so the story does not disappear after an Instagram post moves on.
        </p>
      </div>

      <div class="post-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>

      <div class="button-row">
        <a class="button ghost" href="/blog">View Blog Archive</a>
        <a class="button ghost" href="/events">View Events</a>
      </div>
    </section>
  </div>

  <div class="design-view design-heritage">
    <section class="heritage-hero" aria-labelledby="heritage-hero-title">
      <div class="heritage-hero-copy">
        <p class="eyebrow">Malay Association United Kingdom</p>
        <h1 id="heritage-hero-title">Preserving Malay heritage. Serving families across Britain.</h1>
        <p>
          MAUK is a registered charity supporting Malay culture, language,
          education, welfare and community life in the UK.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href="/about">Our Story</a>
          <a class="button secondary" href="/activities">Our Work</a>
        </div>
      </div>

      <aside class="heritage-portrait" aria-label="Malay Association UK community photograph">
        <img src="/assets/community-members.jpg" alt="MAUK members standing together in traditional Malay clothing" />
        <div>
          <strong>Established community roots</strong>
          <span>From Kelab Melayu history to a registered UK charity.</span>
        </div>
      </aside>
    </section>

    <section class="heritage-facts" aria-label="Organisation details">
      <div>
        <span>Registered charity</span>
        <strong>1186880</strong>
      </div>
      <div>
        <span>CIO number</span>
        <strong>CE019955</strong>
      </div>
      <div>
        <span>Purpose</span>
        <strong>Culture, education and welfare</strong>
      </div>
    </section>

    <section class="heritage-section heritage-purpose" aria-labelledby="heritage-purpose-title">
      <div class="heritage-heading" data-reveal="bubble">
        <p class="eyebrow">Purpose</p>
        <h2 id="heritage-purpose-title">A trusted cultural association preserving Malay identity in Britain.</h2>
      </div>
      <div class="heritage-purpose-grid" data-reveal="bubble">
        <article class="heritage-panel">
          <h3>Heritage</h3>
          <p>Malay language, values, foodways, stories and traditions passed between generations.</p>
        </article>
        <article class="heritage-panel">
          <h3>Education</h3>
          <p>Youth support, workshops, cultural learning and practical guidance for families.</p>
        </article>
        <article class="heritage-panel">
          <h3>Welfare</h3>
          <p>Elder visits, Ramadan support, bereavement notices and care for members facing hardship.</p>
        </article>
      </div>
    </section>

    <section class="heritage-band" aria-labelledby="heritage-history-title">
      <div class="heritage-band-copy" data-reveal="bubble">
        <p class="eyebrow">Community History</p>
        <h2 id="heritage-history-title">Little by little, the hill is formed.</h2>
        <p>
          <em>Sikit-Sikit, Lama-Lama Jadi Bukit</em> describes MAUK's growth: a
          network of families, elders, volunteers and friends becoming an organised
          charity with a wider duty of care.
        </p>
        <a class="text-link" href="/about">Read the history</a>
      </div>
      <figure class="heritage-archive-card" data-reveal="bubble">
        <img src="/assets/family-gathering.jpg" alt="MAUK community members gathered for an outdoor family event" />
        <figcaption>Community photographs should feel like archive material, not decoration.</figcaption>
      </figure>
    </section>

    <section class="heritage-section" aria-labelledby="heritage-work-title">
      <div class="heritage-heading" data-reveal="bubble">
        <p class="eyebrow">What MAUK Does</p>
        <h2 id="heritage-work-title">Cultural preservation with practical community service.</h2>
      </div>
      <div class="heritage-work-grid">
        <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 0ms">
          <span>01</span>
          <h3>Cultural gatherings</h3>
          <p>Hari Raya, food traditions, community meals and occasions that keep Malay identity visible.</p>
        </article>
        <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 70ms">
          <span>02</span>
          <h3>Family education</h3>
          <p>Learning, mentoring and workshops that support young people and parents.</p>
        </article>
        <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 140ms">
          <span>03</span>
          <h3>Care for elders</h3>
          <p>Warga Emas visits, Ramadan gifts and a more attentive welfare network.</p>
        </article>
        <article class="heritage-work-item" data-reveal="bubble" style="--reveal-delay: 210ms">
          <span>04</span>
          <h3>Community support</h3>
          <p>Bereavement support, hardship signposting and fundraising when families need help.</p>
        </article>
      </div>
    </section>

    <section class="heritage-section" aria-labelledby="heritage-latest-title">
      <div class="heritage-heading compact" data-reveal="bubble">
        <p class="eyebrow">Archive</p>
        <h2 id="heritage-latest-title">Recent records from the community.</h2>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="button-row">
        <a class="button ghost" href="/blog">View blog archive</a>
        <a class="button ghost" href="/events">View event listings</a>
      </div>
    </section>
  </div>

  <div class="design-view design-care">
    <section class="care-hero" aria-labelledby="care-hero-title">
      <div class="care-hero-copy">
        <p class="eyebrow">Volunteer-led charity</p>
        <h1 id="care-hero-title">Supporting members through culture, care and service.</h1>
        <p>
          MAUK preserves Malay identity while supporting families, elders and
          community members through education, welfare visits, Ramadan gifts,
          hardship relief and shared cultural life.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href="/contact">Ask for Support</a>
          <a class="button secondary" href="/activities">See Our Work</a>
        </div>
      </div>

      <figure class="care-photo-card">
        <img src="/assets/volunteers.jpg" alt="MAUK volunteers gathered for a community support activity" />
        <figcaption>
          <strong>Community support in practice</strong>
          <span>Care is organised quietly through volunteers, families and trusted community links.</span>
        </figcaption>
      </figure>
    </section>

    <section class="care-trust" aria-label="MAUK trust details">
      <div>
        <span>Charity number</span>
        <strong>1186880</strong>
      </div>
      <div>
        <span>CIO number</span>
        <strong>CE019955</strong>
      </div>
      <div>
        <span>Operating area</span>
        <strong>Across the UK</strong>
      </div>
    </section>

    <section class="care-section" aria-labelledby="care-focus-title">
      <div class="care-heading" data-reveal="bubble">
        <p class="eyebrow">Core Work</p>
        <h2 id="care-focus-title">Culture is the foundation. Care is the duty.</h2>
        <p>
          This version of the site foregrounds MAUK as a charitable organisation:
          a place for cultural belonging, but also a network of practical support.
        </p>
      </div>

      <div class="care-card-grid">
        <article class="care-card" data-reveal="bubble" style="--reveal-delay: 0ms">
          <span>01</span>
          <h3>Education</h3>
          <p>Study support, mentoring, cultural learning and skills sessions for young people and families.</p>
        </article>
        <article class="care-card featured" data-reveal="bubble" style="--reveal-delay: 80ms">
          <span>02</span>
          <h3>Welfare</h3>
          <p>Elderly visits, Ramadan gifts, hardship relief, bereavement notices and signposting when help is needed.</p>
        </article>
        <article class="care-card" data-reveal="bubble" style="--reveal-delay: 160ms">
          <span>03</span>
          <h3>Gatherings</h3>
          <p>Hari Raya, potlucks, bazaars and family events that keep people connected before support is needed.</p>
        </article>
      </div>
    </section>

    <section class="care-service-band" aria-labelledby="care-service-title">
      <div class="care-service-copy" data-reveal="bubble">
        <p class="eyebrow">Welfare Focus</p>
        <h2 id="care-service-title">A community that notices when someone needs help.</h2>
        <p>
          The welfare side of MAUK depends on trust: people who know the families,
          volunteers who can check in, and donors who help make support possible.
        </p>
        <a class="text-link" href="/contact">Offer time, funds or a referral</a>
      </div>
      <div class="care-service-list" data-reveal="bubble">
        <div>
          <strong>Ramadan support</strong>
          <span>Gift distribution, check-ins and care for Warga Emas.</span>
        </div>
        <div>
          <strong>Hardship relief</strong>
          <span>Temporary help, signposting and community fundraising.</span>
        </div>
        <div>
          <strong>Family care</strong>
          <span>Bereavement notices, prayers and practical support during loss.</span>
        </div>
      </div>
    </section>

    <section class="care-section care-community" aria-labelledby="care-community-title">
      <div class="care-community-image" data-reveal="bubble">
        <img src="/assets/family-gathering.jpg" alt="MAUK community members gathered for an outdoor family event" />
      </div>
      <div class="care-community-copy" data-reveal="bubble">
        <p class="eyebrow">Why Culture Matters</p>
        <h2 id="care-community-title">Gatherings build the trust that makes welfare possible.</h2>
        <p>
          Cultural events are not just social occasions. They help families stay
          visible, elders stay connected, and younger members understand the
          community they belong to.
        </p>
      </div>
    </section>

    <section class="care-section" aria-labelledby="care-latest-title">
      <div class="care-heading compact" data-reveal="bubble">
        <p class="eyebrow">Latest Records</p>
        <h2 id="care-latest-title">Recent welfare, notices and community updates.</h2>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="button-row">
        <a class="button ghost" href="/blog">View blog archive</a>
        <a class="button ghost" href="/contact">Contact MAUK</a>
      </div>
    </section>
  </div>
</BaseLayout>
