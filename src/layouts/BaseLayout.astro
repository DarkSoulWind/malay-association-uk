---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@fontsource-variable/plus-jakarta-sans";
import "@styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  type?: "website" | "article";
}

const {
  title,
  description,
  image = "/assets/hero-community.jpg",
  structuredData,
  type = "website"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://malayassociation.co.uk").toString();
const pageTitle = title.includes("Malay Association UK")
  ? title
  : `${title} | Malay Association UK`;
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<!doctype html>
<html lang="en-GB" data-design="heritage">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173629" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Malay Association UK blog" href="/rss.xml" />
    <meta property="og:site_name" content="Malay Association UK" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? "https://malayassociation.co.uk").toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = Array.from(document.querySelectorAll("[data-reveal]"));

      if (!reduceMotion && revealItems.length > 0) {
        document.documentElement.classList.add("reveal-ready");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.16
          }
        );

        requestAnimationFrame(() => {
          revealItems.forEach((item) => observer.observe(item));
        });
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
